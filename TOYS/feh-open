#!/bin/bash

# wrapper script for feh

#window_dimensions=$(xwininfo -id $(xprop -root | awk '/_NET_ACTIVE_WINDOW\(WINDOW\)/{print $NF}') | grep -E '(Width|Height):' | sed 's/.*: \(.*\)/\1/' | sed ':a;N;$!ba;s/\n/x/')
#window_dimensions="2560x1440"
window_dimensions="2350x1674"
NORELOAD=false
# Options may appear in any order; the last non-option argument is the file or directory to open.
while [ $# -gt 0 ]; do
    case "$1" in
        -i|--instances)  INSTANCES="$2"; NORELOAD=true; shift 2 ;;
        -s|--sort)       SORT="$2"; shift 2 ;;
        -t|--scrollstep) SCROLLSTEP="$2"; shift 2 ;;
        -p|--prefetch)   PREFETCH="$2"; shift 2 ;;
        -g|--group-max)  GROUPMAX="$2"; shift 2 ;;   # N, or N1,N2,... for one window per N
        -n|--noreload)   NORELOAD=true; shift ;;
        -r|--reverse)    REVERSE=YES; shift ;;
        -v|--verbose)    VERBOSE=YES; shift ;;
        *)               DIR="$(readlink -f "$1")"; shift ;;
    esac
done



if [ -z $SORT ]; then SORT=filename;fi
if [ -z $INSTANCES ]; then INSTANCES=1;fi
if [ -z $REVERSE ]; then REVERSE=NO;fi
if [ -z $SCROLLSTEP ]; then
    SCROLLSTEP=600
    if [[ "$DIR" == *"/jav"* ]];then
SCROLLSTEP=300
    fi
fi
if [ -z $VERBOSE ]; then VERBOSE=NO;fi

# Slow filesystems (sshfs and other FUSE mounts, NFS, CIFS): turn on feh's
# background read-ahead and stretch the auto-reload, since every reload
# re-lists the whole directory over the network.
FSTYPE="$(stat -f -c %T "$DIR" 2>/dev/null)"
case "$FSTYPE" in
    fuseblk|fuse*|nfs*|cifs|smb*) SLOW_FS=YES ;;
    *) SLOW_FS=NO ;;
esac
if [ -z "$PREFETCH" ]; then
    if [ "$SLOW_FS" == "YES" ]; then PREFETCH=8; else PREFETCH=0; fi
fi
# Sorting by width/height/pixels needs every image's dimensions up front. The
# feh fork reads them from the file headers with 16 threads (~60 ms per file
# over sshfs), so a few thousand files still means a couple of minutes before
# the window appears. Say so rather than look hung.
if [ "$SLOW_FS" == "YES" ]; then
    case "$SORT" in
        width|height|pixels)
            NFILES=$(ls "$DIR" 2>/dev/null | wc -l)
            echo "feh-open: --sort=$SORT on a slow mount: reading $NFILES headers first, expect ~$((NFILES * 60 / 1000 + 5)) s before the window opens" >&2 ;;
    esac
fi
# if [ $INSTANCES -gt 7 ];then
#     RELOAD_TIME_SECONDS=0
# else
# RELOAD_TIME_SECONDS=
#     fi

if [ $SORT == "random" ] || [ $SORT == "shuffle" ];then SORT_ARG=--randomize; else SORT_ARG=--sort=$SORT; fi
declare -a FEH_ARGS=( $SORT_ARG --cache-size 512 --no-jump-on-resort --force-aliasing  --fontpath=/usr/share/fonts/truetype/dejavu --font="DejaVuSans/13" --draw-tinted --scroll-step=$SCROLLSTEP --geometry=${window_dimensions} --draw-filename --auto-zoom)

if [ $SORT == "name" ];then
    SORT=filename
    fi


if [ -z $RELOAD_TIME_SECONDS ]; then
    if [ $SORT == "filename" -o $SORT == "name"  ];then
        if [ "$SLOW_FS" == "YES" ]; then
            RELOAD_TIME_SECONDS=$(shuf -i 300-600 -n 1)
        else
            RELOAD_TIME_SECONDS=$(shuf -i 30-75 -n 1)
        fi
        if [ $NORELOAD == "false" ];then 
            FEH_ARGS=(${FEH_ARGS[@]}   --reload $RELOAD_TIME_SECONDS )
            fi
    else
        RELOAD_TIME_SECONDS=0
    fi
fi

if [ $VERBOSE == "YES" ]; then
    FEH_ARGS=(${FEH_ARGS[@]} --verbose )
else
    FEH_ARGS=(${FEH_ARGS[@]} --quiet )
fi

if [[ "$DIR" == *"/jav"* ]];then
    FEH_ARGS=(${FEH_ARGS[@]}  --keep-zoom-vp --limit-width 2450 )
    # else
    #     FEH_ARGS=(${FEH_ARGS[@]} --auto-zoom )
fi

if [ $REVERSE == "YES" ];then FEH_ARGS=(${FEH_ARGS[@]} --reverse) ;fi
if [ "$PREFETCH" -gt 0 ] 2>/dev/null;then FEH_ARGS=(${FEH_ARGS[@]} --prefetch $PREFETCH) ;fi

open_file() {
    DIR_LOCAL="$1"
    FILE_LOCAL="$2"
    echo "feh ${FEH_ARGS[@]} --start-at ${FILE_LOCAL} $DIR_LOCAL &"    
    feh ${FEH_ARGS[@]} --start-at "${FILE_LOCAL}" "$DIR_LOCAL" &
}

# Build a file list from directory $1 with at most $2 images per
# filename-prefix group, written to $3 (absolute paths):
#   - within a group the picks are spread evenly through the sequence
#     (sorted by name, i.e. by timestamp for the pipeline's exports),
#   - each group's picks stay together as one block, in sequence order,
#   - the blocks come out in random order.
# The group key is the pipeline's episode prefix (everything before
# "__t<seconds>s__s<score>.<ext>") when present, otherwise the name with its
# extension and any trailing digits/separators removed ("set_001.jpg" -> "set").
build_grouped_list() {
    find "$1" -mindepth 1 -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' \) -printf '%f\n' \
    | sort \
    | awk -v n="$2" -v dir="$1" -v seed="$RANDOM$$" '
        BEGIN { srand(seed); OFS = "\t" }
        {
            f = $0; k = f
            if (!sub(/__t[0-9.]+s__s[0-9.]+\.[A-Za-z]+$/, "", k)) {
                sub(/\.[A-Za-z0-9]+$/, "", k); sub(/[0-9._ -]+$/, "", k)
            }
            if (!(k in cnt)) { order[k] = rand(); groups++ }
            cnt[k]++; files[k, cnt[k]] = f
        }
        END {
            for (k in cnt) {
                m = cnt[k]; lim = (m < n) ? m : n
                for (i = 0; i < lim; i++) {
                    idx = int((i + 0.5) * m / lim) + 1      # evenly spaced through the group
                    print order[k], i, dir "/" files[k, idx]
                }
            }
            print groups > ("'"$3"'.groups")
        }' \
    | sort -t "$(printf '\t')" -k1,1g -k2,2n | cut -f3- > "$3"
}

open_grouped() {
    DIR_LOCAL="$1"
    # the list is already in the intended order: drop feh's own sort/shuffle
    declare -a GROUP_ARGS=()
    for a in "${FEH_ARGS[@]}"; do case "$a" in --randomize|--sort=*|--reverse) ;; *) GROUP_ARGS+=("$a") ;; esac; done
    for N in ${GROUPMAX//,/ }; do
        listfile="/tmp/feh_grouped_$$_${N}.txt"
        build_grouped_list "$DIR_LOCAL" "$N" "$listfile"
        echo "group-max $N: $(wc -l < "$listfile") images from $(cat "$listfile.groups") groups"; rm -f "$listfile.groups"
        feh "${GROUP_ARGS[@]}" --title "feh [%u of %l] - %f  (max $N per group)" --filelist "$listfile" &
    done
}

open_directory() {


    
#    if [ "$(expr substr $(uname -s) 1 6)" == "CYGWIN" ]; then

#        DIR_LOCAL=$(cygpath "$1")
#    else
        DIR_LOCAL="$1"    
#    fi



    tmp_find_file=tmp_find_${RANDOM}

    if [ $SORT == "mtime" ];then
        find "$DIR_LOCAL" -mindepth 1 -maxdepth 1 -type f \( -iname \*jpeg -or -iname \*gif -or -iname \*png -or -iname \*jpg \) -printf "%T@ %Tc %p\n" | sort -rn | sed 's/[^\/]\{1,\}\//\//'  > /tmp/$tmp_find_file
    else
        
    find "$DIR_LOCAL" -mindepth 1 -maxdepth 1 -type f \( -iname \*jpeg -or -iname \*gif -or -iname \*png -or -iname \*jpg \) |sort > /tmp/$tmp_find_file
fi

    wait

    num_of_files=$(cat /tmp/$tmp_find_file | wc -l)

    skip_val=$((num_of_files / $INSTANCES))

    i=0
    current_val=0
    declare -a FILES_ARRAY
    #FILES_ARRAY=(one two three)

    #    if [ $INSTANCES -gt 1 ];then
    while [ $i -lt $INSTANCES ];do
        if [ $i -eq 0 ];then
	    POSITION=1

        else
	    POSITION=$((skip_val * i))
            half=$((skip_val / 2)); [ $half -lt 1 ] && half=1
            let "POSITION += $(shuf -i 1-$half -n 1)"
        fi

        if [ $POSITION -gt $num_of_files ];then
	    let POSITION--
        elif [ $POSITION -lt 1 ];then
	    let POSITION++    
        fi


        file_at_pos="$(sed -n ${POSITION}p /tmp/$tmp_find_file)"
        #        file_base="$(echo "$file_at_pos" | sed 's/.*\/\([^\/]\{1,\}[^0-9]\)[0-9\.]\{1,\}\.jpg/\1/')"
        file_base="$(echo "$file_at_pos" | sed 's/.*\///' | sed 's/[^0-9][0-9\.]\{1,\}\.jpg//')"
        #echo "$file_base"
        file_start_num="$(grep -n "$file_base" /tmp/$tmp_find_file | sed 's/^[^:]\{1,\}:\([0-9]\{1,\}\):.*/\1/' | sed 's/^\([0-9]\{1,\}\):.*/\1/' | head -n 1)"
        #echo $file_start_num
        #if [ $((file_start_num)) -lt $((skip_val * i)) ];then
	file_to_touch="$(sed -n ${file_start_num}p /tmp/$tmp_find_file)"
        #else
	#   file_to_touch="$(sed -n ${POSITION}p /tmp/$tmp_find_file)"
        #fi
        FILES_ARRAY[${i}]="$file_to_touch"
        #    echo "$((i + 1)) (${POSITION}) : $file_to_touch"
        #    unset ${FILES_ARRAY[$i]}

        echo "$i $POSITION ${FILES_ARRAY[$i]}"

        echo "feh ${FEH_ARGS[@]} --start-at ${FILES_ARRAY[$i]} $DIR_LOCAL &"
        feh ${FEH_ARGS[@]} --start-at "${FILES_ARRAY[$i]}" "$DIR_LOCAL" &
#        echo "feh ${FEH_ARGS[@]} --start-at ${FILES_ARRAY[$i]}        --filelist=/tmp/${tmp_find_file}"
#       feh ${FEH_ARGS[@]} --start-at "${FILES_ARRAY[$i]}"        --filelist=/tmp/${tmp_find_file} &
        let i++
        current_val=$((current_val + skip_val))

    done
}


if [[ -n ${DIR} ]]; then

    #     echo "FILE: ${DIR}"    
    if [ -f "${DIR}" ]; then # a file is given
        FILE="$DIR"
        DIR="$(echo $DIR | sed 's/\/[^\/]\{1,\}$//')"
        open_file "${DIR}" "${FILE}"

    elif [ -d "${DIR}" ] && [ -n "$GROUPMAX" ]; then # a directory, sampled per prefix group
        open_grouped "${DIR}"
    elif [ -d "${DIR}" ]; then # a directory is given
        open_directory "${DIR}"
    else # file doesn't exist
        echo "error: file doesn't exist: ${DIR}"
        exit 1
    fi
    echo "feh ${FEH_ARGS} $1"
else
    echo "No file specified!"

fi


