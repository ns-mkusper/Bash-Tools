#!/bin/bash

# Usage: ./txt2mp3-running input_file.[txt|md] [bpm]
INPUT_FILE="$1"
BPM="${2:-170}"

if [[ ! -f "$INPUT_FILE" ]]; then
    echo "❌ Error: File '$INPUT_FILE' not found."
    exit 1
fi

BASENAME=$(basename "$INPUT_FILE")
FILENAME="${BASENAME%.*}"

OUTPUT_WAV="/tmp/${FILENAME}.wav"
OUTPUT_WAV_FAST="/tmp/${FILENAME}_fast.wav"
METRONOME_WAV="/tmp/metro.wav"
CLEAN_TEXT=$(mktemp)

OUTPUT_MP3="${FILENAME}_running_${BPM}bpm.mp3"

echo "🧹 Pre-processing text..."
cat "$INPUT_FILE" > "$CLEAN_TEXT"
sed -i "s/[“”]/\"/g; s/[‘’]/'/g; s/…/.../g; s/[—–]/-/g" "$CLEAN_TEXT"

echo "🗣️  Synthesizing voice..."
flite -f "$CLEAN_TEXT" -o "$OUTPUT_WAV"

echo "⏩ Adjusting tempo (1.5x)..."
sox "$OUTPUT_WAV" "$OUTPUT_WAV_FAST" tempo 1.5

echo "🥁 Building $BPM BPM pulse..."
INTERVAL=$(echo "scale=5; 60 / $BPM" | bc)
DURATION=$(soxi -D "$OUTPUT_WAV_FAST")

# 500Hz is a very standard "solid" beep.
# vol 0.8 is high-gain generation.
sox -n "$METRONOME_WAV" synth 0.05 sine 500 vol 0.8 pad 0 0$INTERVAL repeat 10000 trim 0 "$DURATION"

echo "🎵 Mixing background track..."
# volume=0.5 puts the metronome at half-strength relative to the voice.
ffmpeg -nostdin -loglevel quiet -i "$OUTPUT_WAV_FAST" -i "$METRONOME_WAV" \
    -filter_complex "[1:a]volume=0.5[metro];[0:a][metro]amix=inputs=2:duration=first" \
    -acodec libmp3lame -ar 44100 -ab 64000 -y "$OUTPUT_MP3"

# Cleanup
rm "$OUTPUT_WAV" "$OUTPUT_WAV_FAST" "$METRONOME_WAV" "$CLEAN_TEXT"

echo "✅ DONE! Created: $OUTPUT_MP3"